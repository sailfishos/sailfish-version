#!/bin/bash

RET=0
PACKAGELISTD=/usr/share/sailfish-version/packagelist.d

case $1 in
    "--dup")
        if [ -x /usr/bin/rnd-dist-upgrade ]; then
            # Developer mode installed - can use rnd-dist-upgrade directly
            /usr/bin/rnd-dist-upgrade
        elif [ $(id -u) == 0 ]; then
            # Developer mode not installed, but running as root - use pkcon
            pkcon refresh
            MODEL=`ssu model -s | tr '[A-Z]' '[a-z]' | sed 's/ /_/g'`
            pkcon upgrade-system jolla-configuration-$MODEL complete
            echo
            echo "REBOOT NOW, unless you need to investigate update issues, or know what "
            echo "you're doing (or both)."
            echo "All bugs you encounter until reboot are features unless you meet one of the"
            echo "criteria from the previous sentence."
        else
            echo
            echo "Enable developer mode to use rnd-dist-upgrade, or run as root."
            echo
        fi
        ;;
    "--verify")
        if [ -d $PACKAGELISTD ] && [[ `ls -A $PACKAGELISTD` ]]; then
            for i in `cat $PACKAGELISTD/* | sort | uniq`; do
                rpm -q $i > /dev/null 2>&1
                if [ $? -ne 0 ]; then
                    PACKAGE=`echo $i | awk -F - '{ OFS="-"; $NF=""; $(NF-1)=""; print }' | sed 's/-*$//'`
                    IPACKAGE=`rpm -q $PACKAGE`
                    echo -e "+ $i\n- $IPACKAGE"
                    RET=255
                fi
            done
        fi
        if [ $RET -ne 0 ]; then
            . /etc/os-release
            echo
            echo "One ore more packages are not at the expected version for $PRETTY_NAME"
            echo "(+ = expected version, - = installed version)"
        fi
        ;;
    "")
        if [ -f /etc/os-release ]; then
            . /etc/os-release
            echo $PRETTY_NAME
        else
            echo "release file does not exist"
        fi
        ;;
    *)
        echo "Invalid option '$1' given, allowed options --dup and --verify."
        ;;
esac

exit $RET
